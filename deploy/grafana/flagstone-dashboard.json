      },
      "targets": [
        {
          "expr": "sum by (flagstone_status) (rate(flagstone_auth_apikey_validation_total[$__rate_interval]))",
          "legendFormat": "{{ flagstone_status }}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 }
    },
    {
      "id": 17,
      "title": "Token Refresh by Status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "cps"
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "sum by (flagstone_status) (rate(flagstone_auth_refresh_total[$__rate_interval]))",
          "legendFormat": "{{ flagstone_status }}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 }
    },
    {
      "id": 18,
      "title": "Rate Limit Hits by Endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "cps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "sum by (flagstone_auth_endpoint) (rate(flagstone_auth_ratelimit_hits_total[$__rate_interval]))",
          "legendFormat": "{{ flagstone_auth_endpoint }}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 }
    },
    {
      "id": 19,
      "title": "Logouts / s",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
