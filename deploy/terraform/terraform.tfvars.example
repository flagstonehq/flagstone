# =============================================================================
# Flagstone — Example variables file
# =============================================================================
# Copy this to terraform.tfvars (which is gitignored) and fill in your values.
# NEVER commit terraform.tfvars — it contains secrets.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # edit terraform.tfvars with your values
#   terraform plan
# =============================================================================

aws_region   = "us-east-1"
project_name = "flagstone"
environment  = "dev"

# REQUIRED — no default. Find your public IP with: curl ifconfig.me
# Then set it here as YOUR_IP/32 (the /32 means "exactly this address").
# terraform apply will REFUSE to run if this is 0.0.0.0/0.
ssh_allowed_cidr = "YOUR_IP/32"

# Create this key pair in the AWS Console first:
#   EC2 → Key Pairs → Create key pair → Name it "flagstone" → Download .pem
# Then `chmod 400 ~/.ssh/flagstone.pem`
key_pair_name = "flagstone"

# Strong random password (minimum 16 characters). Generate one with:
#   openssl rand -base64 32
# In production, fetch from AWS Secrets Manager instead of hardcoding.
db_password = "REPLACE_ME_WITH_A_STRONG_RANDOM_PASSWORD"
