# =============================================================================
# Flagstone — Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked. Everything else has a safe default.
# =============================================================================

# ---- Server ---------------------------------------------------------------

# Listen address (default: ":8080")
# FLAGSTONE_ADDR=:8080

# Environment name used for resource attributes and cookie security.
# Set to "production" to enable Secure cookies. (default: "development")
# FLAGSTONE_ENV=development

# ---- Database (REQUIRED) --------------------------------------------------

# Postgres connection string (e.g. postgres://user:pass@host:5432/db?sslmode=disable)
# DATABASE_URL=postgres://flagstone:flagstone_dev@localhost:5432/flagstone?sslmode=disable

# ---- Redis -----------------------------------------------------------------

# Redis connection string. Only needed for SSE pub/sub between instances.
# Not required for single-instance setups. (default: redis://localhost:6379)
# REDIS_URL=redis://localhost:6379

# ---- Auth (REQUIRED) ------------------------------------------------------

# JWT signing key — must be at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-chars

# Access token TTL (default: 15m)
# ACCESS_TOKEN_TTL=15m

# Refresh token TTL (default: 168h = 7 days)
# REFRESH_TOKEN_TTL=168h

# bcrypt cost for password hashing (default: 12)
# BCRYPT_COST=12

# Random bytes used for API key generation (default: 32)
# API_KEY_RANDOM_BYTES=32

# ---- Rate Limiting --------------------------------------------------------

# Max login attempts per minute per IP (default: 5)
# LOGIN_RATE_LIMIT=5

# Max evaluations per minute per API key (default: 1000)
# EVALUATE_RATE_LIMIT=1000

# ---- Cache ----------------------------------------------------------------

# How long to cache flag configurations in memory (default: 30s)
# FLAG_CACHE_TTL=30s

# ---- OpenTelemetry (optional) ---------------------------------------------
# By default metrics and traces are disabled. Set any OTEL_* variable to
# enable. See docs/OBSERVABILITY.md for the full reference.

# Comma-separated list: "otlp", "prometheus", or "otlp,prometheus"
# OTEL_METRICS_EXPORTER=prometheus

# Trace exporter: "otlp" or "none"
# OTEL_TRACES_EXPORTER=otlp

# OTLP endpoint for traces and metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name for resource attributes (default: "flagstone")
# OTEL_SERVICE_NAME=flagstone

# Prometheus metrics endpoint host (default: "0.0.0.0")
# OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0

# Prometheus metrics endpoint port (default: "9464")
# OTEL_EXPORTER_PROMETHEUS_PORT=9464

# Trace sampler: "always_on", "always_off", "parentbased_traceidratio"
# OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Sampling ratio when using traceidratio sampler (default: "0.1")
# OTEL_TRACES_SAMPLER_ARG=0.1

# Additional resource attributes (key=value, comma-separated)
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=1.0.0
