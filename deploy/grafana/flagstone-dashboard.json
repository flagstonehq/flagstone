          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "rate(flagstone_db_pool_connections_acquired_total[$__rate_interval])",
          "legendFormat": "acquire/s",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 15 }
    },
    {
      "id": 13,
      "title": "DB Acquire Wait / s",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "rate(flagstone_db_pool_acquire_wait_duration_seconds_total[$__rate_interval])",
          "legendFormat": "wait/s",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 12 }
    },
    {
      "id": 14,
      "title": "Login Attempts by Status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "cps"
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "sum by (flagstone_status) (rate(flagstone_auth_login_total[$__rate_interval]))",
          "legendFormat": "{{ flagstone_status }}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 }
    },
    {
      "id": 15,
      "title": "Login Failures by Error Code",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "cps"
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "sum by (flagstone_auth_error_code) (rate(flagstone_auth_login_total{flagstone_status=\"failure\"}[$__rate_interval]))",
          "legendFormat": "{{ flagstone_auth_error_code }}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 }
    },
