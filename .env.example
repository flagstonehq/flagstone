# =============================================================================
# Flagstone — Environment variables
# =============================================================================
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# Server
FLAGSTONE_ADDR=:8080
FLAGSTONE_ENV=development

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://flagstone:flagstone_dev@localhost:5432/flagstone?sslmode=disable

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Auth — JWT secret for dashboard sessions (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_ME

# OpenTelemetry (optional — disabled if unset)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=flagstone
